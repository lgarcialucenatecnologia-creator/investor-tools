# Puerto del API (el frontend Next corre en el 3000)
PORT=4000

# Origen permitido por CORS
FRONTEND_URL=http://localhost:3000

# MongoDB — Atlas Cluster0, base propia de la plataforma.
# Convención de nombres: platform_dev (desarrollo) · platform_prod (producción).
# El funnel de captación vive en el MISMO clúster pero en las bases 'dev' y
# 'prod'. Nunca apuntar la plataforma a esas dos.
# Si la clave tiene caracteres especiales, codifícalos en URL: ! → %21  @ → %40
MONGODB_URI=mongodb+srv://<usuario>:<clave>@cluster0.bji7zzb.mongodb.net/platform_dev?retryWrites=true&w=majority&appName=Cluster0

# Secretos JWT — genera cada uno con: openssl rand -base64 48
# Deben ser DISTINTOS entre sí y nunca subirse al repositorio.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
