# Puerto del API (el frontend Next corre en el 3000)
PORT=4000

# Origen permitido por CORS
FRONTEND_URL=http://localhost:3000

# Saltos de proxy delante del API. En local 0; en Vercel, Railway o detrás
# de Nginx suele ser 1. Si queda en 0 con un proxy delante, el límite de
# intentos cuenta la IP del proxy y TODOS los usuarios comparten un cupo.
TRUST_PROXY_HOPS=0

# El acceso lo da el asesor tras la compra, no un formulario público.
# Dejar en false salvo que se abra el registro a propósito.
SELF_REGISTRATION_ENABLED=false

# Administrador inicial. Lo usa `npm run seed:admin`, que hay que ejecutar a
# mano: nada del arranque del servidor lee estas variables, para que borrar la
# cuenta no la resucite en el siguiente despliegue.
#
# Si defines ADMIN_PASSWORD, la cuenta queda activa con esa contraseña y no
# pasa por «Soy usuario nuevo». Si la dejas vacía, la cuenta queda pendiente y
# su dueño crea la contraseña él mismo, que es lo más seguro.
#
# ⚠️ La contraseña queda escrita en este archivo y en los registros del
# despliegue. En producción, cámbiala desde la aplicación tras el primer
# ingreso y borra la variable.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Vigencia por defecto de una cuenta nueva, en meses. En el alta se puede
# cambiar la fecha o dejarla sin vencimiento.
ACCESS_DEFAULT_MONTHS=12

# Filtro de Seguridad: valores por defecto del formulario, como proporción.
# 0.02 es 2%. Cada análisis puede usar otros.
FILTER_DEED_COST_RATE=0.02
FILTER_TAX_RATE=0.015
FILTER_SAFETY_MARGIN_RATE=0.05

# Plazo, en horas, para que un usuario recién dado de alta cree su
# contraseña. Acota la ventana en la que su cuenta puede ser reclamada por
# alguien que conozca el correo.
ACTIVATION_TTL_HOURS=72

# Sesiones simultáneas por usuario (computador y celular a la vez).
SESSION_MAX_PER_USER=5
# Margen en el que el refresh recién rotado sigue valiendo. Sin él, dos
# pestañas refrescando a la vez se leen como robo y cierran la sesión.
SESSION_ROTATION_GRACE_MS=30000

# MongoDB — Atlas Cluster0, base propia de la plataforma.
# Convención de nombres: platform_dev (desarrollo) · platform_prod (producción).
# El funnel de captación vive en el MISMO clúster pero en las bases 'dev' y
# 'prod'. Nunca apuntar la plataforma a esas dos.
# Si la clave tiene caracteres especiales, codifícalos en URL: ! → %21  @ → %40
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/platform_dev?retryWrites=true&w=majority&appName=Cluster0

# Secretos JWT — genera cada uno con: openssl rand -base64 48
# Deben ser DISTINTOS entre sí y nunca subirse al repositorio. Que difieran
# es lo ÚNICO que impide usar un refresh de 7 días como token de acceso, así
# que el arranque falla si son iguales.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
