# Dirección del backend NestJS, sin el sufijo /api: ese prefijo lo pone el
# código, porque es una propiedad del backend y no algo que deba recordar
# quien despliega.
#
# Sin el prefijo NEXT_PUBLIC_ a propósito: el navegador nunca la ve, porque
# habla con las rutas del propio Next y son ellas las que llaman al API
# guardando la sesión en cookies httpOnly.
API_URL=http://localhost:4000
